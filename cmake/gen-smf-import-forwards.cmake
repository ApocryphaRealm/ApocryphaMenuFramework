# Writes the export forwarders of the SMF import module (stub/SMFImportModule.cpp, 2.4.0) from the framework DLL's own
# export table, so the module forwards exactly what AMF exports - never a hand-kept list that drifts.
#
# Run by CMakeLists.txt as a build step after the framework links:
#   cmake -DLINKER=<link.exe> -DDLL=<!ApocryphaMenuFramework.dll> -DOUT=<generated .cpp> -P gen-smf-import-forwards.cmake
#
# Each export becomes  #pragma comment(linker, "/export:NAME=!ApocryphaMenuFramework.NAME")  - a forwarder the Windows
# loader resolves to the framework's own function. The pragma form is used because link.exe 14.51 refuses the same
# forwarder written in a .def file or on its command line ("unresolved external symbol"), and accepts it from an object.
# SKSE's three loader entry points are left out: the import module is not an SKSE plugin and must never look like one.

if (NOT LINKER OR NOT DLL OR NOT OUT)
	message(FATAL_ERROR "gen-smf-import-forwards: LINKER, DLL and OUT are required")
endif()

execute_process(
	COMMAND "${LINKER}" /dump /nologo /exports "${DLL}"
	OUTPUT_VARIABLE dump
	RESULT_VARIABLE rc
)
if (NOT rc EQUAL 0)
	message(FATAL_ERROR "gen-smf-import-forwards: '${LINKER} /dump /exports' failed (${rc}) on ${DLL}")
endif()

get_filename_component(target_module "${DLL}" NAME_WE)

string(REPLACE "\n" ";" lines "${dump}")
set(names "")
foreach (line IN LISTS lines)
	# "    ordinal hint RVA      name" rows:  "          1    0 0001A2B0 AMF_CloseMenu"
	if (line MATCHES "^ +[0-9]+ +[0-9A-Fa-f]+ +[0-9A-Fa-f]+ +([A-Za-z_][A-Za-z0-9_]*)")
		set(name "${CMAKE_MATCH_1}")
		if (NOT name MATCHES "^SKSEPlugin_")
			list(APPEND names "${name}")
		endif()
	endif()
endforeach()

list(LENGTH names count)
if (count LESS 100)
	message(FATAL_ERROR "gen-smf-import-forwards: only ${count} exports read from ${DLL} - the dump format has changed")
endif()

set(text "// GENERATED by cmake/gen-smf-import-forwards.cmake from ${target_module}.dll's export table - do not edit.\n")
string(APPEND text "// ${count} forwarders: SKSEMenuFramework.dll!NAME -> ${target_module}.dll!NAME\n")
foreach (name IN LISTS names)
	string(APPEND text "#pragma comment(linker, \"/export:${name}=${target_module}.${name}\")\n")
endforeach()

file(WRITE "${OUT}" "${text}")
