+    // AMF 2.3.0 (amf-slider-value.patch): the value is never left under the grab. Centred as before while it clears the
+    // grab; when the grab sits on it, it moves to the wider side of the grab that holds it whole; when neither side does
+    // (a frame too narrow for its value at a big text size), it stays centred on a plate in the frame's colour, the text's
+    // height only, so the grab still shows above and below it. The box used is published in GImGuiSliderValueRect.
+    ImVec2 value_min = frame_bb.Min, value_max = frame_bb.Max;
+    if (grab_bb.Max.x > grab_bb.Min.x)
+    {
+        const ImVec2 value_size = CalcTextSize(value_buf, value_buf_end, false);
+        const float centre = (frame_bb.Min.x + frame_bb.Max.x) * 0.5f;
+        const float pad = style.FramePadding.x;
+        const float margin = pad * 0.5f;   // the grab art can reach a little past its box
+        if (centre - value_size.x * 0.5f - margin < grab_bb.Max.x && grab_bb.Min.x < centre + value_size.x * 0.5f + margin)
+        {
+            const float left_room = grab_bb.Min.x - frame_bb.Min.x - pad;
+            const float right_room = frame_bb.Max.x - grab_bb.Max.x - pad;
+            if (right_room >= value_size.x + margin && right_room >= left_room)
+                value_min.x = grab_bb.Max.x;
+            else if (left_room >= value_size.x + margin)
+                value_max.x = grab_bb.Min.x;
+            else
+            {
+                const float edge = ImMax(1.0f, pad * 0.35f);
+                const float x0 = ImMax(frame_bb.Min.x, centre - value_size.x * 0.5f - edge);
+                const float x1 = ImMin(frame_bb.Max.x, centre + value_size.x * 0.5f + edge);
+                const float y0 = ImMax(frame_bb.Min.y, (frame_bb.Min.y + frame_bb.Max.y - value_size.y) * 0.5f);
+                const float y1 = ImMin(frame_bb.Max.y, y0 + value_size.y);
+                window->DrawList->AddRectFilled(ImVec2(x0, y0), ImVec2(x1, y1), frame_col | IM_COL32_A_MASK, ImMin(style.FrameRounding, value_size.y * 0.25f));
+            }
+        }
+    }
+    GImGuiSliderValueId = id;
+    GImGuiSliderValueRect = ImRect(value_min, value_max);
+    RenderTextClipped(value_min, value_max, value_buf, value_buf_end, NULL, ImVec2(0.5f, 0.5f));
 
