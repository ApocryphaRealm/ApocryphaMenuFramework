diff --git a/imgui_draw.cpp b/imgui_draw.cpp
index 125c25c..b4f2b39 100644
--- a/imgui_draw.cpp
+++ b/imgui_draw.cpp
@@ -3784,13 +3784,23 @@ void ImFont::AddRemapChar(ImWchar dst, ImWchar src, bool overwrite_dst)
     IndexAdvanceX[dst] = (src < index_size) ? IndexAdvanceX.Data[src] : 1.0f;
 }
 
+ImGuiGlyphMissHookFn GImGuiGlyphMissHook = NULL;   // AMF glyph misses (imgui_internal.h)
+
 const ImFontGlyph* ImFont::FindGlyph(ImWchar c) const
 {
     if (c >= (size_t)IndexLookup.Size)
+    {
+        if (GImGuiGlyphMissHook)
+            GImGuiGlyphMissHook(this, c);
         return FallbackGlyph;
+    }
     const ImWchar i = IndexLookup.Data[c];
     if (i == (ImWchar)-1)
+    {
+        if (GImGuiGlyphMissHook)
+            GImGuiGlyphMissHook(this, c);
         return FallbackGlyph;
+    }
     return &Glyphs.Data[i];
 }
 
